# ==============================
# 模型服务凭据
# ==============================
# 方式 A：使用 Anthropic 官方模型服务
ANTHROPIC_API_KEY=sk-ant-api03-...
BEARBOT_RECOVERY_API_KEY=sk-ant-api03-...

# 方式 B：使用自定义 OpenAI 兼容接口时按需添加，例如：
# OPENAI_API_KEY=sk-...

# ==============================
# IM 平台凭据（按需启用）
# ==============================
# Telegram 机器人令牌（从 @BotFather 获取）
TELEGRAM_BOT_TOKEN=

# QQ 开放平台机器人凭据
QQ_BOT_APP_ID=
QQ_BOT_CLIENT_SECRET=
